{
  "expo": {
    "name": "OpsPro Picker",
    "slug": "opspro-picker-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "opspro-picker",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ae.opspro.picker",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "OpsPro Picker connects to a development server on this network while testing. The App Store version does not use the local network."
      }
    },
    "android": {
      "package": "ae.opspro.picker",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to approve your OpsPro clock-in or clock-out."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow OpsPro Picker to verify that you are at your rostered store when you clock in or out."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OpsPro Picker takes a photo of your face when you clock in or out, so your hours are recorded as yours.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B5746"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OpsPro Picker needs your photos so you can choose a reference photo or a document from your library."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
