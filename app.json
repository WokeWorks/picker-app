{
  "expo": {
    "name": "OpsPro Picker",
    "slug": "opspro-picker-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "opspro-picker",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ae.opspro.picker",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ae.opspro.picker",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to approve your OpsPro clock-in or clock-out."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Use Face ID to unlock this phone's OpsPro device key."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow OpsPro Picker to verify that you are at your rostered store when you clock in or out."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
